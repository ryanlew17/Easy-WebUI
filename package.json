{
  "name": "easy-webui",
  "version": "1.0.4",
  "private": true,
  "description": "Easy WebUI — local-first multi-provider LLM chat client",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "predev": "node scripts/node-version-guard.mjs",
    "dev": "vite",
    "predev:electron": "node scripts/node-version-guard.mjs",
    "dev:electron": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "prebuild": "node scripts/node-version-guard.mjs",
    "build": "tsc -p tsconfig.web.json --noEmit && vite build && tsc -p tsconfig.electron.json && esbuild electron/preload.ts --bundle --platform=node --external:electron --format=cjs --outfile=dist-electron/electron/preload.js",
    "pretest": "node scripts/node-version-guard.mjs",
    "test": "vitest run",
    "preperf": "node scripts/node-version-guard.mjs",
    "perf": "npm run build && node scripts/perf-main.mjs && node scripts/perf-renderer.mjs",
    "preperf:electron": "node scripts/node-version-guard.mjs",
    "perf:electron": "npm run build && node scripts/perf-electron.mjs",
    "preshot": "node scripts/node-version-guard.mjs",
    "shot": "node scripts/shot.mjs",
    "pretypecheck": "node scripts/node-version-guard.mjs",
    "typecheck": "tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "postinstall": "install-electron"
  },
  "engines": {
    "node": ">=26.13.1 <27"
  },
  "dependencies": {
    "adm-zip": "^0.6.0",
    "better-sqlite3": "^13.0.3",
    "dompurify": "^3.1.7",
    "electron-updater": "^6.8.11",
    "highlight.js": "^11.10.0",
    "i18next": "^23.16.5",
    "js-tiktoken": "^1.0.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.1.1",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/adm-zip": "^0.5.7",
    "@types/better-sqlite3": "^9.6.0",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^24.19.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.1",
    "esbuild": "^0.28.2",
    "puppeteer-core": "^25.16.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vitest": "^5.0.5",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "com.easywebui.app",
    "productName": "Easy WebUI",
    "files": [
      "dist",
      "dist-electron",
      "package.json"
    ],
    "npmRebuild": false,
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "ryanlew17",
        "repo": "Easy-WebUI"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "artifactName": "EasyWebUI_${version}_Setup.${ext}",
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "EasyWebUI_${version}_Portable.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    }
  },
  "allowScripts": {
    "electron@45.4.1": true,
    "better-sqlite3": true,
    "electron-winstaller": true,
    "esbuild": true
  },
  "overrides": {
    "minimatch@^9.0.0": "^11.0.1",
    "minimatch@^10.0.0": "^11.0.1"
  }
}
