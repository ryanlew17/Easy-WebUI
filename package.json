{
  "name": "easy-webui",
  "version": "0.1.2-beta.1",
  "private": true,
  "description": "Easy WebUI — local-first multi-provider LLM chat client",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:electron": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build": "tsc -p tsconfig.web.json --noEmit && vite build && tsc -p tsconfig.electron.json && esbuild electron/preload.ts --bundle --platform=node --external:electron --format=cjs --outfile=dist-electron/electron/preload.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.electron.json --noEmit"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "adm-zip": "^0.6.0",
    "better-sqlite3": "^13.0.3",
    "dompurify": "^3.1.7",
    "electron-updater": "^6.8.9",
    "highlight.js": "^11.10.0",
    "i18next": "^23.16.5",
    "js-tiktoken": "^1.0.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.1.1",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0",
    "zod": "^3.23.8",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/adm-zip": "^0.5.7",
    "@types/better-sqlite3": "^9.6.0",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^22.9.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "postcss": "^8.4.49",
    "puppeteer-core": "^25.9.0",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.easywebui.app",
    "productName": "Easy WebUI",
    "files": [
      "dist",
      "dist-electron",
      "package.json"
    ],
    "npmRebuild": false,
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "ryanlew17",
        "repo": "Easy-WebUI"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "artifactName": "EasyWebUI_${version}_Setup.${ext}",
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "EasyWebUI_${version}_Portable.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    }
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "better-sqlite3": true,
    "electron-winstaller": true,
    "esbuild": true
  }
}
